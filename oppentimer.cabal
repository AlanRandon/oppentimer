cabal-version:   3.0
name:            oppentimer
version:         0.1.0.0
license:         NONE
author:          Alan Randon, Harry Stevens, Tinron Chan, Tom Obungu
build-type:      Simple

common warnings
    ghc-options: -Wall

executable example
    import:           warnings
    main-is:          Main.hs
    other-modules:
        Oppentimer
        Oppentimer.Timer
        Oppentimer.Audio
        -- Cutscene
    build-depends:
        apecs,
        apecs-gloss,
        gloss-juicy,
        gloss,
        base,
        containers,
        GLUT
    hs-source-dirs:   src
    default-language: Haskell2010
    c-sources: src/AUDIO_FFI_STUFF/audio.c
    cc-options: -std=c11 -Wnopedantic
